				{
					"name": "Iniciar sesión como propietario",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Datos únicos por corrida: las pruebas son repetibles (FIRST).",
									"const s = Date.now().toString(36);",
									"pm.collectionVariables.set('sufijo', s);",
									"pm.collectionVariables.set('ruta', 'vyv-newman-' + s);",
									"pm.collectionVariables.set('webhookId', require('uuid').v4());"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('HTTP 200', () => pm.response.to.have.status(200));",
									"pm.test('sesión del propietario', () => pm.expect(pm.response.json().data.email).to.eql(pm.environment.get('ownerEmail')));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "browser-id",
								"value": "{{browserId}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"emailOrLdapLoginId\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}"
						},
						"url": "{{baseUrl}}/rest/login"
					}
				},
